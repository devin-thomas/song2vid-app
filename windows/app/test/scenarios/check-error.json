{
  "vars": {
    "code": "audio_unreadable",
    "message": "Song2Vid can't read this audio file.",
    "exit": 3
  },
  "steps": [
    {
      "line": {
        "type": "error",
        "error": {
          "code": "${code}",
          "message": "${message}"
        }
      }
    },
    {
      "exit": "${exit}"
    }
  ]
}
